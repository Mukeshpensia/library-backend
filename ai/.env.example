# AI recommender DB credentials.
# Reuse the backend's database — the simplest path is:  cp ../.env .env
# Only the DB_* vars below are read by the recommender.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db
# TLS: leave on for managed DBs (Aiven etc.); set false for plain local MySQL.
DB_SSL=true

# Tuning (optional — sensible defaults baked into the code)
TOP_N=20
W_CF=0.6
W_CONTENT=0.4
