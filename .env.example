# ---------------------------------------------------------------------------
# Library Management System - Backend environment
# Copy to `.env` and fill in real values:  cp .env.example .env
# These are the variables the code actually reads.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (MySQL 8). NOTE: plugins/db.js connects on the default port (3306)
# and does not currently read DB_PORT. If your MySQL runs on another port,
# wire DB_PORT into plugins/db.js first.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db

# Auth. Single secret signs the JWT access tokens (TTL is hard-coded to 15m in
# the auth service; refresh tokens live 7 days). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend origin allowed by CORS (browser sends the refresh-token cookie)
WEBSITE_URL=http://localhost:3000

# Cron. The daily maintenance jobs (overdue reminders, etc.) run either via
# in-process node-cron OR via the POST /cron/daily endpoint triggered by an
# external scheduler. On hosts that sleep (e.g. Render free tier) set
# CRON_EXTERNAL=true and have the scheduler POST /cron/daily with this secret in
# the x-cron-secret header. Leave CRON_EXTERNAL unset for normal in-process cron.
CRON_SECRET=change-me-to-a-long-random-secret
# CRON_EXTERNAL=true

# Uploads. Book covers are re-encoded on upload to a modern image format.
# Allowed: webp (default, fast + universal) or avif (smaller, slower to encode).
COVER_IMAGE_FORMAT=webp

# Email (SendGrid). Used for welcome + password-reset mails.
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=no-reply@example.com
EMAIL_FROM=no-reply@example.com
