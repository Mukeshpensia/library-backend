# ---------------------------------------------------------------------------
# Library Management System - Backend environment
# Copy to `.env` and fill in real values:  cp .env.example .env
# These are the variables the code actually reads.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (MySQL 8). NOTE: plugins/db.js connects on the default port (3306)
# and does not currently read DB_PORT. If your MySQL runs on another port,
# wire DB_PORT into plugins/db.js first.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db

# Auth. Single secret signs the JWT access tokens (TTL is hard-coded to 15m in
# the auth service; refresh tokens live 7 days). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend origin allowed by CORS (browser sends the refresh-token cookie)
WEBSITE_URL=http://localhost:3000

# Email (SendGrid). Used for welcome + password-reset mails.
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=no-reply@example.com
EMAIL_FROM=no-reply@example.com
